# 本機開發用的 Cloudflare Secrets 範本。
# 複製這個檔案為 .dev.vars（該檔名已被 .gitignore 排除，不會被提交），
# 填入本機測試用的假值或個人測試帳號的真實值後再執行 `wrangler dev`。
#
# 正式環境一律使用 `wrangler secret put <NAME>` 個別設定，
# 不要把正式機密寫進任何會被 git 追蹤的檔案。

# Meta App Dashboard 的 App Secret，用於驗證 Webhook 簽章。
META_APP_SECRET=

# 自訂的 Webhook Verify Token，需與 Meta App Dashboard 設定的值一致。
META_VERIFY_TOKEN=

# Instagram Professional Account 的 Access Token。
INSTAGRAM_ACCESS_TOKEN=

# 管理者 Session 簽章用的隨機字串（建議 32 bytes 以上的隨機值）。
ADMIN_SESSION_SECRET=

# 用於加密任何需要落地保存之機密欄位的金鑰（建議 32 bytes 以上的隨機值）。
TOKEN_ENCRYPTION_KEY=
